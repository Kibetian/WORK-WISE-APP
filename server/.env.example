# Copy to .env and adjust. Every value here has a working default except
# SECRET_KEY, which you must change before deploying anywhere real.

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite by default; point at Postgres for anything shared.
DATABASE_URL=sqlite:///./workwise.db
# DATABASE_URL=postgresql+psycopg://workwise:workwise@localhost:5432/workwise
SQL_ECHO=false

ENVIRONMENT=development

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_UPLOAD_MB=10
